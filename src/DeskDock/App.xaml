<Application x:Class="DeskDock.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <Style TargetType="Button">
   <Setter Property="Background" Value="#29323A"/><Setter Property="Foreground" Value="#EEF4F6"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/>
   <Setter Property="Margin" Value="3"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#3D5057"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#D1DADD"/><Setter Property="Margin" Value="6"/></Style>
  <Style TargetType="TabItem">
   <Setter Property="Foreground" Value="#CAD7DA"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
    <Border x:Name="Tab" Background="#202E35" Padding="22,11" CornerRadius="14" Margin="0,0,6,6">
     <ContentPresenter ContentSource="Header"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True">
     <Setter TargetName="Tab" Property="Background" Value="#304940"/><Setter Property="Foreground" Value="#8CF0C2"/>
    </Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Application.Resources>
</Application>
