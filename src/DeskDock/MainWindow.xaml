<Window x:Class="DeskDock.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 Title="DeskDock" Width="490" Height="740" MinWidth="390" MinHeight="500"
 Background="#12191E" Foreground="#EAF1F4" FontFamily="Segoe UI" FontSize="13"
 WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
 Loaded="WindowLoaded" Closing="WindowClosing" StateChanged="WindowStateChanged">
 <Grid Margin="12">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel Margin="0,0,0,10">
   <DockPanel>
    <TextBlock Text="DeskDock" FontSize="23" FontWeight="SemiBold" VerticalAlignment="Center"/>
    <Button DockPanel.Dock="Right" Content="Bandeja" Click="HideClick" HorizontalAlignment="Right" ToolTip="Ocultar junto al reloj"/>
   </DockPanel>
   <WrapPanel>
    <CheckBox x:Name="Pin" Content="Siempre encima" Click="SettingsClick"/>
    <CheckBox x:Name="TrayOption" Content="Minimizar a bandeja" IsChecked="True" Click="SettingsClick"/>
   </WrapPanel>
  </StackPanel>
  <TabControl Grid.Row="1" Background="#192228" BorderThickness="0" Padding="0,10,0,0">
   <TabItem Header="WhatsApp">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <WrapPanel>
      <Button Content="Recargar" Click="ReloadClick"/>
      <Button Content="Abrir en navegador ↗" Click="BrowserClick"/>
     </WrapPanel>
     <TextBlock x:Name="WebStatus" Grid.Row="1" Text="Preparando WhatsApp…" TextWrapping="Wrap" Foreground="#A8BABF" Margin="6,6,6,10"/>
     <wv:WebView2 x:Name="Web" Grid.Row="2" DefaultBackgroundColor="#192228"/>
    </Grid>
   </TabItem>
   <TabItem Header="Spotify">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel Margin="18,24">
      <TextBlock Text="Tu música, a mano." FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/>
      <TextBlock Margin="0,12,0,16" Foreground="#A8BABF" TextWrapping="Wrap"
       Text="Abre Spotify y reproduce una canción. DeskDock buscará su sesión multimedia de Windows para mostrarla y controlarla desde el mini reproductor."/>
      <Button Content="Abrir Spotify ↗" Click="SpotifyClick" HorizontalAlignment="Left" Background="#235E48"/>
      <TextBlock x:Name="MediaStatus" Margin="0,18,0,0" TextWrapping="Wrap" Text="Buscando la sesión de Spotify…"/>
      <TextBlock Margin="0,16,0,0" Foreground="#A8BABF" TextWrapping="Wrap"
       Text="Los botones dependen de lo que Spotify permita controlar. No se usa Spotify Web API. Guardar canciones queda para una versión futura."/>
      <TextBlock x:Name="NotificationStatus" Margin="0,24,0,0" Foreground="#A8BABF" TextWrapping="Wrap"
       Text="WhatsApp: notificaciones aún no comprobadas. Actívalas en WhatsApp y permite el acceso cuando se solicite."/>
      <Button Content="Abrir carpeta de diagnóstico" Click="DiagnosticsClick" HorizontalAlignment="Left" Margin="0,18,0,0"/>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
  </TabControl>
  <Border Grid.Row="2" Background="#202B31" CornerRadius="10" Padding="12" Margin="0,12,0,0">
   <StackPanel>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="52"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border Width="44" Height="44" Background="#35454B" CornerRadius="5" VerticalAlignment="Top">
      <Image x:Name="Artwork" Stretch="UniformToFill" AutomationProperties.Name="Portada de la canción"/>
     </Border>
     <StackPanel Grid.Column="1">
      <TextBlock x:Name="TrackTitle" Text="Sin sesión de Spotify" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
      <TextBlock x:Name="TrackArtist" Text="Abre Spotify y reproduce música" Foreground="#A8BABF" TextTrimming="CharacterEllipsis" Margin="0,5,0,0"/>
     </StackPanel>
    </Grid>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,4">
     <Button x:Name="Previous" Content="⏮" IsEnabled="False" Click="PreviousClick" ToolTip="Anterior" AutomationProperties.Name="Canción anterior"/>
     <Button x:Name="Play" Content="▶" IsEnabled="False" Click="PlayClick" ToolTip="Reproducir" AutomationProperties.Name="Reproducir"/>
     <Button x:Name="Pause" Content="⏸" IsEnabled="False" Click="PauseClick" ToolTip="Pausar" AutomationProperties.Name="Pausar"/>
     <Button x:Name="Next" Content="⏭" IsEnabled="False" Click="NextClick" ToolTip="Siguiente" AutomationProperties.Name="Canción siguiente"/>
    </StackPanel>
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions>
     <Button x:Name="Mute" Content="Silenciar" Click="MuteClick" IsEnabled="False" FontSize="11"/>
     <Slider x:Name="MasterVolume" Grid.Column="1" Minimum="0" Maximum="100" VerticalAlignment="Center" Margin="10,0" IsEnabled="False" ValueChanged="VolumeChanged" AutomationProperties.Name="Volumen maestro de Windows"/>
     <TextBlock x:Name="VolumeValue" Grid.Column="2" VerticalAlignment="Center" Text="—"/>
    </Grid>
    <TextBlock x:Name="AudioStatus" Text="Volumen maestro de Windows" FontSize="11" Foreground="#A8BABF" TextWrapping="Wrap" Margin="4,5,0,0"/>
   </StackPanel>
  </Border>
 </Grid>
</Window>
