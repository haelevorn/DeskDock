<Window x:Class="DeskDock.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:wv="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="DeskDock v0.9.0" Icon="Assets/DeskDock.ico" Width="360" Height="520" MinWidth="300" MinHeight="340"
 Background="{DynamicResource WindowBackground}" Foreground="{DynamicResource TextPrimary}" FontFamily="Segoe UI" FontSize="13" WindowStyle="None"
 WindowStartupLocation="CenterScreen" ResizeMode="CanResize"
 Loaded="WindowLoaded" Closing="WindowClosing" StateChanged="WindowStateChanged" SourceInitialized="WindowSourceInitialized" SizeChanged="ResponsiveSizeChanged" DpiChanged="MainDpiChanged">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="16" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Grid>
 <Border x:Name="SkinFrame" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource FrameBrush}" Background="{DynamicResource AmbientBackdrop}" IsHitTestVisible="False"/>
 <Grid Margin="10,6,10,10">
  <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid>
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel x:Name="HeaderBrand" Orientation="Horizontal" VerticalAlignment="Center" Margin="5,0,0,0">
    <Ellipse Fill="{DynamicResource AccentBrush}" Width="7" Height="7" Margin="0,0,9,0"/>
    <TextBlock Text="DeskDock" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
   </StackPanel>
   <StackPanel x:Name="HeaderActions" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <TextBlock x:Name="ClockText" FontSize="11" Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" Margin="0,0,7,0" AutomationProperties.Name="Hora actual de Windows"/>
    <Button x:Name="UltraMiniButton" Style="{StaticResource IconButton}" Width="24" Margin="1,0" Click="EnterUltraMiniClick" ToolTip="Modo ultramini" AutomationProperties.Name="Modo ultramini">
     <Path Style="{StaticResource ToolbarVector}" Data="{StaticResource AntGeometry}" Stroke="{DynamicResource AccentBrush}"/>
    </Button>
    <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Content="&#xE712;" Click="MoreClick" ToolTip="Opciones y acciones" AutomationProperties.Name="Opciones y acciones">
     <Button.ContextMenu>
      <ContextMenu>
       <MenuItem Header="Recargar WhatsApp" Click="ReloadClick"/>
       <MenuItem Header="Ver lista de chats" Click="ChatListClick"/>
       <MenuItem Header="Ver conversación" Click="ConversationClick"/>
       <MenuItem Header="Abrir WhatsApp en navegador" Click="BrowserClick"/>
       <MenuItem Header="Abrir aplicación Spotify" Click="SpotifyClick"/>
       <Separator/>
       <MenuItem x:Name="CompactWhatsApp" Header="Vista adaptable de WhatsApp" IsCheckable="True" IsChecked="True" Click="CompactClick"/>
       <MenuItem x:Name="Pin" Header="Siempre encima" IsCheckable="True" Click="SettingsClick"/>
       <MenuItem x:Name="TrayOption" Header="Minimizar a bandeja" IsCheckable="True" IsChecked="True" Click="SettingsClick"/>
       <MenuItem Header="Ocultar en bandeja" Click="HideClick"/>
       <MenuItem Header="Tamaño compacto" Click="CompactWindowClick"/>
       <MenuItem Header="Modo ultramini" Click="EnterUltraMiniClick"/>
       <Separator/>
       <MenuItem Header="SKINS" IsEnabled="False"/>
       <MenuItem x:Name="MinimalSkin" Header="Minimal · original" Tag="minimal" IsCheckable="True" Click="SkinClick"/>
       <MenuItem x:Name="AuroraSkin" Header="Aurora · azul y violeta" Tag="aurora" IsCheckable="True" Click="SkinClick"/>
       <MenuItem x:Name="EclipseSkin" Header="Eclipse · negro y ámbar" Tag="eclipse" IsCheckable="True" Click="SkinClick"/>
       <Separator/>
       <MenuItem x:Name="SoundOption" Header="Sonidos de avisos" IsCheckable="True" IsChecked="True" Click="SettingsClick"/>
       <MenuItem Header="Activar avisos de WhatsApp" Click="EnableNotificationsClick"/>
       <MenuItem Header="Probar aviso" Click="TestNotificationClick"/>
       <MenuItem Header="Probar sonido de Pomodoro" Click="TestPomodoroNotificationClick"/>
       <MenuItem Header="Ver estado y avisos…" Click="StatusClick"/>
       <MenuItem Header="Abrir carpeta de diagnóstico" Click="DiagnosticsClick"/>
      </ContextMenu>
     </Button.ContextMenu>
    </Button>
    <Button Style="{StaticResource IconButton}" Width="26" Margin="1,0" Content="&#xE921;" Click="MinimizeClick" ToolTip="Minimizar" AutomationProperties.Name="Minimizar"/>
    <Button Style="{StaticResource IconButton}" Width="26" Margin="1,0" Content="&#xE922;" Click="MaximizeClick" ToolTip="Maximizar o restaurar" AutomationProperties.Name="Maximizar o restaurar"/>
    <Button Style="{StaticResource IconButton}" Width="26" Margin="1,0" Content="&#xE8BB;" Click="CloseClick" ToolTip="Cerrar DeskDock" AutomationProperties.Name="Cerrar DeskDock"/>
   </StackPanel>
  </Grid>
  <TabControl x:Name="MainTabs" Grid.Row="1" Background="{DynamicResource SurfaceBackground}" BorderThickness="0" Padding="0,4,0,0" SelectionChanged="MainTabChanged">
   <TabItem Header="WhatsApp">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <StackPanel x:Name="WhatsAppToolbar" Orientation="Horizontal" Margin="1,0,0,2">
      <Button x:Name="ChatListButton" Content="Chats" Click="ChatListClick" Padding="9,3" FontSize="11" Margin="2,0" ToolTip="Ver lista de chats" AutomationProperties.Name="Ver lista de chats"/>
      <Button x:Name="ConversationButton" Content="Chat" Click="ConversationClick" Padding="9,3" FontSize="11" Margin="2,0" ToolTip="Ver conversación completa" AutomationProperties.Name="Ver conversación"/>
      <Button Click="EnableNotificationsClick" Padding="9,3" Margin="2,0" ToolTip="Permitir notificaciones del sitio WhatsApp">
       <TextBlock x:Name="WebNoticeState" Text="Avisos" FontSize="10" Foreground="{DynamicResource TextSecondary}"/>
      </Button>
     </StackPanel>
     <Border Grid.Row="1" CornerRadius="12" Background="{DynamicResource SurfaceBackground}">
      <wv:WebView2 x:Name="Web" DefaultBackgroundColor="#192228" SizeChanged="WebSizeChanged"/>
     </Border>
    </Grid>
   </TabItem>
   <TabItem Header="Spotify">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel x:Name="SpotifyContent" Margin="16,12">
      <TextBlock Text="SONANDO AHORA" FontSize="10" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center"/>
      <Border x:Name="SpotifyCover" Background="{DynamicResource ArtworkBackground}" CornerRadius="18" Margin="0,10,0,10" Width="130" Height="130" HorizontalAlignment="Center">
       <Grid>
        <TextBlock Text="♪" FontSize="65" Foreground="{DynamicResource TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        <Image x:Name="FullArtwork" Source="{Binding Artwork}" Stretch="Uniform" AutomationProperties.Name="Portada de la canción en Spotify"/>
       </Grid>
      </Border>
      <TextBlock x:Name="FullTrackTitle" Text="{Binding Title}" FontSize="21" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center"/>
      <TextBlock x:Name="FullTrackArtist" Text="{Binding Artist}" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,10"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
       <Button x:Name="FullPrevious" Style="{StaticResource IconButton}" Content="&#xE892;" Width="38" Height="38" IsEnabled="{Binding CanPrevious}" Click="PreviousClick" ToolTip="Anterior" AutomationProperties.Name="Canción anterior"/>
       <Grid Width="50" Height="44" Margin="12,0">
        <Button x:Name="FullPlay" Style="{StaticResource PlayIconButton}" Content="&#xE768;" Width="44" Height="44" Background="{DynamicResource PlayBackground}" IsEnabled="{Binding CanPlay}" Click="PlayClick" ToolTip="Reproducir" AutomationProperties.Name="Reproducir"/>
        <Button x:Name="FullPause" Style="{StaticResource PauseIconButton}" Content="&#xE769;" Width="44" Height="44" Background="{DynamicResource PlayBackground}" IsEnabled="{Binding CanPause}" Click="PauseClick" ToolTip="Pausar" AutomationProperties.Name="Pausar"/>
       </Grid>
       <Button x:Name="FullNext" Style="{StaticResource IconButton}" Content="&#xE893;" Width="38" Height="38" IsEnabled="{Binding CanNext}" Click="NextClick" ToolTip="Siguiente" AutomationProperties.Name="Canción siguiente"/>
      </StackPanel>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="Pomodoro">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
     <StackPanel Margin="14,10" TextElement.Foreground="{DynamicResource TextPrimary}">
      <TextBlock x:Name="PomoStage" Text="Concentración" FontSize="12" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center"/>
      <TextBlock x:Name="PomoTime" Text="25:00" FontSize="46" FontWeight="Light" HorizontalAlignment="Center" Margin="0,3,0,0" AutomationProperties.Name="Tiempo restante del pomodoro"/>
      <TextBlock x:Name="PomoSessions" Foreground="{DynamicResource TextSecondary}" FontSize="10" HorizontalAlignment="Center"/>
      <ProgressBar x:Name="PomoProgress" Minimum="0" Maximum="100" Height="3" BorderThickness="0" Foreground="{DynamicResource AccentBrush}" Background="{DynamicResource BorderBrush}" Margin="14,12,14,9"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
       <Button x:Name="PomoStart" Content="Iniciar" Click="PomoStartClick" Padding="18,7" Background="{DynamicResource PlayBackground}"/>
       <Button Content="&#xE777;" Style="{StaticResource IconButton}" Click="PomoResetClick" ToolTip="Reiniciar el ciclo" AutomationProperties.Name="Reiniciar ciclo pomodoro"/>
      </StackPanel>
      <TextBlock x:Name="PomoMessage" Text="Configura tus etapas y pulsa Iniciar." TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondary}" Margin="0,10,0,8"/>
      <Expander x:Name="PomoConfigExpander" Header="Configurar etapas" Foreground="{DynamicResource TextPrimary}" FontSize="12">
       <StackPanel Margin="0,9,0,4">
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
         <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
         <TextBlock Text="Concentración (min)" VerticalAlignment="Center"/>
         <TextBox x:Name="FocusMinutes" Grid.Column="1" MaxLength="3" AutomationProperties.Name="Minutos de concentración"/>
         <TextBlock Grid.Row="1" Text="Descanso corto (min)" VerticalAlignment="Center"/>
         <TextBox x:Name="ShortMinutes" Grid.Row="1" Grid.Column="1" MaxLength="2" AutomationProperties.Name="Minutos de descanso corto"/>
         <TextBlock Grid.Row="2" Text="Descanso largo (min)" VerticalAlignment="Center"/>
         <TextBox x:Name="LongMinutes" Grid.Row="2" Grid.Column="1" MaxLength="3" AutomationProperties.Name="Minutos de descanso largo"/>
         <TextBlock Grid.Row="3" Text="Sesiones antes del largo" VerticalAlignment="Center"/>
         <TextBox x:Name="RoundCount" Grid.Row="3" Grid.Column="1" MaxLength="2" AutomationProperties.Name="Sesiones antes de descanso largo"/>
        </Grid>
        <CheckBox x:Name="AutoStages" Content="Pasar de etapa automáticamente" FontSize="11" Margin="0,8,0,4"/>
        <Button Content="Aplicar y reiniciar" Click="ApplyPomodoroClick" HorizontalAlignment="Left" Padding="10,6"/>
       </StackPanel>
      </Expander>
      <Expander x:Name="ProfilesExpander" Header="Mis pomodoros" Margin="0,10,0,0">
       <StackPanel Margin="0,8,0,4">
        <ComboBox x:Name="ProfilePicker" DisplayMemberPath="Name" MinHeight="30" SelectionChanged="ProfileSelectionChanged" AutomationProperties.Name="Perfiles de Pomodoro guardados"/>
        <TextBox x:Name="ProfileName" MaxLength="40" Margin="0,8,0,4" ToolTip="Nombre personalizado, hasta 40 caracteres" AutomationProperties.Name="Nombre del perfil de Pomodoro"/>
        <WrapPanel>
         <Button Content="Guardar" Click="SaveProfileClick" Padding="9,6"/>
         <Button Content="Cargar y reiniciar" Click="LoadProfileClick" Padding="9,6"/>
         <Button Content="Eliminar" Click="DeleteProfileClick" Padding="9,6"/>
        </WrapPanel>
        <TextBlock Text="Guardar usa los valores de Configurar etapas. Un mismo nombre actualiza ese perfil." TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextSecondary}" Margin="0,6,0,0"/>
       </StackPanel>
      </Expander>
     </StackPanel>
    </ScrollViewer>
   </TabItem>
   <TabItem Header="Referencia">
    <Grid AllowDrop="True" Drop="ReferenceDrop" DragOver="ReferenceDragOver">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <DockPanel Margin="3,3,3,5">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
       <Button x:Name="ReferenceOpenButton" Style="{StaticResource IconButton}" Click="OpenReferenceClick" ToolTip="Abrir imagen" AutomationProperties.Name="Abrir imagen de referencia"><Path Style="{StaticResource ToolbarVector}" Data="{StaticResource ReferenceFolderGeometry}"/></Button>
       <Button x:Name="ReferenceRecentButton" Style="{StaticResource IconButton}" Click="MoreClick" ToolTip="Abrir reciente" AutomationProperties.Name="Abrir imagen reciente">
        <Path Style="{StaticResource ToolbarVector}" Data="{StaticResource ReferenceHistoryGeometry}"/>
        <Button.ContextMenu><ContextMenu Opened="RecentReferencesOpened"/></Button.ContextMenu>
       </Button>
       <Button x:Name="ReferenceFitButton" Style="{StaticResource IconButton}" Click="FitReferenceClick" ToolTip="Ajustar imagen" AutomationProperties.Name="Ajustar imagen"><Path Style="{StaticResource ToolbarVector}" Data="{StaticResource ReferenceFitGeometry}"/></Button>
       <Button x:Name="ReferenceRotateButton" Style="{StaticResource IconButton}" Click="RotateReferenceClick" ToolTip="Girar 90 grados" AutomationProperties.Name="Girar referencia 90 grados"><Path Style="{StaticResource ToolbarVector}" Data="{StaticResource ReferenceRotateGeometry}"/></Button>
       <Button x:Name="ReferenceFlipButton" Style="{StaticResource IconButton}" Click="FlipReferenceClick" ToolTip="Voltear horizontalmente" AutomationProperties.Name="Voltear referencia horizontalmente"><Path Style="{StaticResource ToolbarVector}" Data="{StaticResource ReferenceFlipGeometry}"/></Button>
       <Button x:Name="ReferenceZoomOutButton" Style="{StaticResource IconButton}" Click="ZoomOutReferenceClick" ToolTip="Alejar" AutomationProperties.Name="Alejar imagen"><Path Style="{StaticResource ToolbarVector}" Data="{StaticResource ReferenceZoomOutGeometry}"/></Button>
       <Button x:Name="ReferenceZoomInButton" Style="{StaticResource IconButton}" Click="ZoomInReferenceClick" ToolTip="Acercar" AutomationProperties.Name="Acercar imagen"><Path Style="{StaticResource ToolbarVector}" Data="{StaticResource ReferenceZoomInGeometry}"/></Button>
       <Button x:Name="ReferenceRemoveButton" Style="{StaticResource IconButton}" Click="ClearReferenceClick" ToolTip="Quitar referencia (no borra el archivo)" AutomationProperties.Name="Quitar referencia"><Path Style="{StaticResource ToolbarVector}" Data="{StaticResource ReferenceRemoveGeometry}"/></Button>
      </StackPanel>
     </DockPanel>
     <Border Grid.Row="1" CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" ClipToBounds="True">
      <Grid>
       <Canvas x:Name="ReferenceCanvas" Background="Transparent" ClipToBounds="True" SizeChanged="ReferenceSizeChanged"
        MouseWheel="ReferenceWheel" MouseLeftButtonDown="ReferenceDown" MouseMove="ReferenceMove" MouseLeftButtonUp="ReferenceUp" LostMouseCapture="ReferenceLostCapture">
        <Image x:Name="ReferencePhoto" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
       </Canvas>
       <TextBlock x:Name="ReferenceHint" Text="Abre o arrastra una imagen.&#10;Rueda para zoom; arrastra para mover." TextWrapping="Wrap" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Margin="20" IsHitTestVisible="False"/>
      </Grid>
     </Border>
     <TextBlock x:Name="ReferenceStatus" Grid.Row="2" Text="PNG, JPG, BMP, GIF o TIFF · imagen local" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="5,5"/>
    </Grid>
   </TabItem>
   <TabItem Header="ChatGPT">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <WrapPanel Margin="2,2,2,3">
      <Button Content="Recargar" Click="ReloadChatGptClick" FontSize="10" Padding="7,4"/>
      <Button Content="Abrir navegador ↗" Click="OpenChatGptBrowserClick" FontSize="10" Padding="7,4"/>
      <Button Content="Cerrar web" Click="CloseChatGptClick" FontSize="10" Padding="7,4" ToolTip="Liberar los recursos de esta pestaña"/>
     </WrapPanel>
     <TextBlock x:Name="ChatGptStatus" Grid.Row="1" Text="ChatGPT web experimental. Se carga al abrir esta pestaña; el acceso con cuenta requiere prueba real." Foreground="{DynamicResource TextSecondary}" FontSize="10" TextWrapping="Wrap" Margin="6,0,6,6"/>
     <Grid x:Name="ChatGptHost" Grid.Row="2"/>
    </Grid>
   </TabItem>
  </TabControl>
  <Button x:Name="PomoBadge" Grid.Row="2" Visibility="Collapsed" Height="24" Padding="8,2" Margin="0,4,0,0" Click="PomoBadgeClick" Background="{DynamicResource SelectedBackground}" ToolTip="Volver al Pomodoro activo" AutomationProperties.Name="Ver Pomodoro activo">
   <TextBlock x:Name="PomoBadgeText" Foreground="{DynamicResource AccentBrush}" FontSize="10"/>
  </Button>
  <Border x:Name="MiniPlayer" Grid.Row="3" Height="54" CornerRadius="12" Background="{DynamicResource PlayerBackground}" Margin="0,7,0,0" Padding="8,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition x:Name="MiniArtColumn" Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border x:Name="MiniArtworkFrame" Width="30" Height="30" Background="{DynamicResource ArtworkBackground}" CornerRadius="7" VerticalAlignment="Center">
     <Image x:Name="Artwork" Source="{Binding Artwork}" Stretch="UniformToFill" AutomationProperties.Name="Portada de la canción"/>
    </Border>
    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="1,0,6,0">
     <TextBlock x:Name="TrackTitle" Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
     <TextBlock x:Name="TrackArtist" Text="{Binding Artist}" FontSize="10" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" ToolTip="{Binding Artist}"/>
    </StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="Previous" Style="{StaticResource IconButton}" Content="&#xE892;" IsEnabled="{Binding CanPrevious}" Click="PreviousClick" ToolTip="Anterior" AutomationProperties.Name="Canción anterior"/>
     <Grid Width="30" Height="30">
      <Button x:Name="Play" Style="{StaticResource PlayIconButton}" Content="&#xE768;" IsEnabled="{Binding CanPlay}" Click="PlayClick" ToolTip="Reproducir" AutomationProperties.Name="Reproducir"/>
      <Button x:Name="Pause" Style="{StaticResource PauseIconButton}" Content="&#xE769;" IsEnabled="{Binding CanPause}" Click="PauseClick" ToolTip="Pausar" AutomationProperties.Name="Pausar"/>
     </Grid>
     <Button x:Name="Next" Style="{StaticResource IconButton}" Content="&#xE893;" IsEnabled="{Binding CanNext}" Click="NextClick" ToolTip="Siguiente" AutomationProperties.Name="Canción siguiente"/>
     <Button Style="{StaticResource IconButton}" Content="&#xE767;" Click="MoreClick" ToolTip="Volumen maestro de Windows" AutomationProperties.Name="Abrir volumen maestro">
      <Button.ContextMenu>
       <ContextMenu>
        <MenuItem StaysOpenOnClick="True" Focusable="False">
         <MenuItem.Header>
          <StackPanel Width="190" Margin="2,4">
           <DockPanel Margin="0,0,0,8"><TextBlock Text="Volumen de Windows"/><TextBlock x:Name="VolumeValue" Text="—" HorizontalAlignment="Right"/></DockPanel>
           <Slider x:Name="MasterVolume" Minimum="0" Maximum="100" IsEnabled="False" ValueChanged="VolumeChanged" AutomationProperties.Name="Volumen maestro de Windows"/>
          </StackPanel>
         </MenuItem.Header>
        </MenuItem>
        <MenuItem StaysOpenOnClick="True">
         <MenuItem.Header><Button x:Name="Mute" Content="Silenciar" Click="MuteClick" IsEnabled="False" Padding="6,4" Margin="0" Background="Transparent"/></MenuItem.Header>
        </MenuItem>
       </ContextMenu>
      </Button.ContextMenu>
     </Button>
    </StackPanel>
   </Grid>
  </Border>
  <StackPanel Visibility="Collapsed">
   <TextBlock x:Name="WebStatus" Text="Preparando WhatsApp…"/>
   <TextBlock x:Name="LayoutStatus"/>
   <TextBlock x:Name="MediaStatus" Text="Buscando sesión de Spotify…"/>
   <TextBlock x:Name="NotificationStatus" Text="Avisos sin comprobar. Usa Probar aviso en el menú."/>
   <TextBlock x:Name="AudioStatus" Text="Volumen maestro de Windows"/>
  </StackPanel>
 </Grid>
 </Grid>
</Window>
